# Earth Rover Vehicle Control Station - environment
# On the rover these live in ~/.config/earth-rover/secrets.env (mode 600, not in git),
# which every er-* unit reads. Never commit real values.

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Address rosbridge (:9090), web_video_server (:8080) and the VCS (:8000) listen on.
# Default 127.0.0.1. 0.0.0.0 on the rover, where ufw admits those ports from the
# cable interface only.
VCS_BIND_ADDRESS=127.0.0.1

# Optional
# VCS_DEBUG=1                      # Django debug pages
# VCS_ALLOWED_HOSTS=*              # comma-separated Host names
# ROS_BRIDGE_URL=ws://<host>:9090  # default: the host that served the page
# VIDEO_SERVER_URL=http://<host>:8080
# RECORD_BAG_DIR=~/earth-rover-bags
