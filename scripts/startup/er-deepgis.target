# Hand-written sidecar (not generated from mission.yaml).
# The DeepGIS link: MAVROS, the telemetry, pose and keyframe publishers. This is the one
# piece of the rover stack that starts at boot (lingering user manager):
#   systemctl --user enable er-deepgis.target      # on at boot
#   systemctl --user disable --now er-deepgis.target
[Unit]
Description=Earth Rover DeepGIS link (MAVROS + telemetry + pose + keyframes)
Wants=er-deepgis-mavros.service er-deepgis-telemetry.service er-deepgis-pose.service er-deepgis-keyframe.service
After=er-deepgis-mavros.service er-deepgis-telemetry.service er-deepgis-pose.service er-deepgis-keyframe.service

[Install]
WantedBy=default.target
